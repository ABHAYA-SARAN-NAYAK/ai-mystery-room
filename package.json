{
  "name": "ai-mystery-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:server": "npm run build --workspace=@mystery/shared && npm run build --workspace=@mystery/server",
    "build:client": "npm run build --workspace=@mystery/shared && npm run build --workspace=@mystery/client",
    "start:server": "npm run start --workspace=@mystery/server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:gemini": "npm run check:gemini --workspace=@mystery/server",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "npm run build --workspace=@mystery/shared && tsc -b"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
